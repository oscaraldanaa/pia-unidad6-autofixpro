# ============================================================
# AutoFix Pro — variables de entorno (12-Factor App, factor III)
# Copia este archivo a `.env` y ajusta los valores. NO subas `.env` a Git.
# Todos los valores de abajo son de ejemplo; no contienen secretos reales.
# ============================================================

# --- Aplicación ---
APP_ENV=development            # development | test | production
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
API_HOST=0.0.0.0
API_PORT=8000

# --- Base de datos (SQLAlchemy URL) ---
# Opción 1 (por defecto, desarrollo local): SQLite
DATABASE_URL=sqlite:///./autofixpro.db
# Opción 2: MySQL (docker-compose usará estas mismas variables)
# DATABASE_URL=mysql+pymysql://autofix_user:CAMBIAR_PASSWORD@db:3306/autofixpro
SQL_ECHO=false                 # true imprime el SQL generado (solo depuración)

# --- Variables para el contenedor MySQL (docker-compose) ---
MYSQL_DATABASE=autofixpro
MYSQL_USER=autofix_user
MYSQL_PASSWORD=CAMBIAR_PASSWORD
MYSQL_ROOT_PASSWORD=CAMBIAR_ROOT_PASSWORD

# --- Reglas de negocio configurables ---
TASA_IVA=16                    # % aplicado a cotizaciones (supuesto a validar con el stakeholder)
CANAL_NOTIFICACIONES=log       # log | sms | email (solo 'log' implementado)
